# Local dev (standalone Postgres cluster, see README):
DATABASE_URL=postgres://stoba95:devpass@localhost:5434/stoba95
PGSSL=false

# On Render, DATABASE_URL comes from the managed Postgres instance and
# PGSSL should be left unset (defaults to sslmode required, rejectUnauthorized: false).

PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
